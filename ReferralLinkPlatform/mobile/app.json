{
  "expo": {
    "name": "Instabids Referral",
    "slug": "instabids-referral",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2196F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.instabids.referral",
      "buildNumber": "1",
      "infoPlist": {
        "NSContactsUsageDescription": "This app needs access to your contacts to share referral links with friends."
      }
    },
    "android": {
      "package": "ai.instabids.referral",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2196F3"
      },
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://referrallink-platform-production.up.railway.app",
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}